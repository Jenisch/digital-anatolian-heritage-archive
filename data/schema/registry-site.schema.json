{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daha.example/schema/registry-site.schema.json",
  "title": "DAHA Registry Site",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "canonicalName",
    "alternateNames",
    "entityTypes",
    "historicalRegions",
    "modernLocation",
    "coordinates",
    "chronologySummary",
    "researchStatus",
    "discoverySources",
    "authorityIdentifiers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^site:[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 1
    },
    "alternateNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ancient-city",
          "settlement",
          "tell",
          "sanctuary",
          "necropolis",
          "fortress",
          "palace",
          "monastery",
          "church",
          "port",
          "landscape",
          "other",
          "unknown"
        ]
      }
    },
    "historicalRegions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "modernLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "province", "district", "locality"],
      "properties": {
        "country": { "const": "Türkiye" },
        "province": { "type": ["string", "null"] },
        "district": { "type": ["string", "null"] },
        "locality": { "type": ["string", "null"] }
      }
    },
    "coordinates": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "precision"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "precision": {
              "type": "string",
              "enum": ["site", "locality", "district", "province", "approximate"]
            }
          }
        }
      ]
    },
    "chronologySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayDate", "startYear", "endYear", "certainty"],
      "properties": {
        "displayDate": { "type": ["string", "null"] },
        "startYear": { "type": ["integer", "null"] },
        "endYear": { "type": ["integer", "null"] },
        "certainty": {
          "type": "string",
          "enum": ["exact", "approximate", "range", "disputed", "unknown"]
        }
      }
    },
    "researchStatus": {
      "type": "string",
      "enum": ["indexed", "location-verified", "authority-linked", "sourced-record"]
    },
    "discoverySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "role": {
            "type": "string",
            "enum": ["seed-catalogue", "location-verification", "authority", "research"]
          }
        }
      }
    },
    "authorityIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wikidata", "unesco", "pleiades"],
      "properties": {
        "wikidata": { "type": ["string", "null"] },
        "unesco": { "type": ["string", "null"] },
        "pleiades": { "type": ["string", "null"] }
      }
    },
    "recordPath": {
      "type": ["string", "null"]
    },
    "dataQualityNotes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lastReviewed": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}