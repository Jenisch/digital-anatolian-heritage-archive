{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalanatolianheritage.org/schema/site.schema.json",
  "title": "Digital Anatolian Heritage Archive Site Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "canonicalName",
    "coordinates",
    "modernLocation",
    "siteTypes",
    "chronology",
    "bibliography",
    "recordVersion"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^site:[a-z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonicalName": { "type": "string", "minLength": 1 },
    "alternativeNames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "language": { "type": ["string", "null"] },
          "script": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "enum": ["site", "approximate", "regional"] }
      },
      "additionalProperties": false
    },
    "modernLocation": {
      "type": "object",
      "required": ["country", "province"],
      "properties": {
        "country": { "type": "string" },
        "province": { "type": "string" },
        "district": { "type": ["string", "null"] },
        "locality": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "siteTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "chronology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "displayDate", "certainty", "sourceIds"],
        "properties": {
          "label": { "type": "string" },
          "startYear": { "type": ["integer", "null"] },
          "endYear": { "type": ["integer", "null"] },
          "displayDate": { "type": "string" },
          "certainty": {
            "enum": ["exact", "approximate", "range", "disputed", "unknown"]
          },
          "datingBasis": {
            "enum": ["archaeological", "historical", "radiocarbon", "mixed", "unknown"]
          },
          "note": { "type": ["string", "null"] },
          "sourceIds": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "cultures": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "historicalContext": { "type": ["string", "null"] },
    "archaeologicalSignificance": { "type": ["string", "null"] },
    "excavationHistory": { "type": ["string", "null"] },
    "heritageStatus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "identifier": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "externalIdentifiers": {
      "type": "object",
      "properties": {
        "wikidata": { "type": ["string", "null"], "pattern": "^Q[0-9]+$" },
        "unesco": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "citation", "sourceType"],
        "properties": {
          "id": { "type": "string" },
          "citation": { "type": "string" },
          "sourceType": {
            "enum": ["academic", "excavation", "institutional", "heritage-register", "authority-data", "other"]
          },
          "doi": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "format": "uri" },
          "accessedOn": { "type": ["string", "null"], "format": "date" }
        },
        "additionalProperties": false
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source", "rightsStatus"],
        "properties": {
          "type": { "enum": ["image", "map", "plan", "scan", "other"] },
          "title": { "type": ["string", "null"] },
          "creator": { "type": ["string", "null"] },
          "source": { "type": "string" },
          "sourceUrl": { "type": ["string", "null"], "format": "uri" },
          "rightsStatus": { "type": "string" },
          "licenceUrl": { "type": ["string", "null"], "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "recordVersion": { "type": "integer", "minimum": 1 },
    "lastReviewed": { "type": ["string", "null"], "format": "date" },
    "editorialNotes": { "type": ["string", "null"] }
  }
}
